 {
  "name": "D7-issue-sheet",
  "url": "http://localhost:5177/automations/auto_03",
  "width": 1280,
  "height": 1000,
  "wait": 2500,
  "steps": [
   {
    "eval": "(()=>{document.querySelectorAll('[data-shoot]').forEach(e=>e.removeAttribute('data-shoot'));const el=[...document.querySelectorAll('button,[role=button],div')].find(e=>e.textContent.trim().startsWith('Stale plan after upgrade') && e.children.length<=3); if(el){el.setAttribute('data-shoot','1'); return 'tagged: '+el.tagName+' '+(el.textContent||'').trim().slice(0,30)} return 'NOT FOUND'})()",
    "wait": 100
   },
   {
    "click": "[data-shoot='1']",
    "wait": 1200
   }
  ]
 },
