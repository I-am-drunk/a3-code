  "steps": [
   {
    "eval": "(()=>{document.querySelectorAll('[data-shoot]').forEach(e=>e.removeAttribute('data-shoot'));const el=[...document.querySelectorAll('button')].find(e=>e.textContent.trim()==='Add trigger'); if(el){el.setAttribute('data-shoot','1'); return 'tagged: '+el.tagName+' '+(el.textContent||'').trim().slice(0,30)} return 'NOT FOUND'})()",
    "wait": 100
   },
